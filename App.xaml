<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:FoodOrderingApp"
             x:Class="FoodOrderingApp.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ===== Color palette ===== -->
            <Color x:Key="PrimaryOrange">#FF6B35</Color>
            <Color x:Key="SecondaryOrange">#FF8C42</Color>
            <Color x:Key="OrangeDeep">#E9501F</Color>
            <Color x:Key="OrangeSoft">#FFF1E8</Color>
            <Color x:Key="PageBackground">#FAF6F2</Color>
            <Color x:Key="CardWhite">#FFFFFF</Color>
            <Color x:Key="TextMain">#1E232B</Color>
            <Color x:Key="TextSecondary">#7A8496</Color>
            <Color x:Key="Line">#F0E7DF</Color>
            <Color x:Key="Success">#17A673</Color>
            <Color x:Key="SuccessSoft">#E6F7F0</Color>
            <Color x:Key="Danger">#E5484D</Color>

            <!-- ===== Base typography ===== -->
            <Style TargetType="Label">
                <Setter Property="FontFamily" Value="OpenSansRegular" />
                <Setter Property="TextColor" Value="{StaticResource TextMain}" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <Style TargetType="Page" ApplyToDerivedTypes="True">
                <Setter Property="Padding" Value="0" />
                <Setter Property="BackgroundColor" Value="{StaticResource PageBackground}" />
            </Style>

            <!-- ===== Buttons ===== -->
            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryOrange}" />
                <Setter Property="BorderWidth" Value="0" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="MinimumHeightRequest" Value="44" />
                <Setter Property="MinimumWidthRequest" Value="44" />
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryOrange}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="BorderWidth" Value="0" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="HeightRequest" Value="52" />
                <Setter Property="MinimumHeightRequest" Value="52" />
                <Setter Property="Padding" Value="18,0" />
            </Style>

            <Style x:Key="SecondaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{StaticResource PrimaryOrange}" />
                <Setter Property="BorderColor" Value="{StaticResource PrimaryOrange}" />
                <Setter Property="BorderWidth" Value="1.5" />
                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="HeightRequest" Value="50" />
                <Setter Property="MinimumHeightRequest" Value="50" />
                <Setter Property="Padding" Value="18,0" />
            </Style>

            <!-- Round orange "+" used on food cards -->
            <Style x:Key="AddIconButton" TargetType="Button">
                <Setter Property="FontFamily" Value="FASolid" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryOrange}" />
                <Setter Property="BorderWidth" Value="0" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="WidthRequest" Value="36" />
                <Setter Property="HeightRequest" Value="36" />
                <Setter Property="MinimumWidthRequest" Value="36" />
                <Setter Property="MinimumHeightRequest" Value="36" />
                <Setter Property="Padding" Value="0" />
            </Style>

            <!-- Small white circle inside the quantity stepper -->
            <Style x:Key="StepButton" TargetType="Button">
                <Setter Property="FontFamily" Value="FASolid" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextColor" Value="{StaticResource PrimaryOrange}" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="BorderWidth" Value="0" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="WidthRequest" Value="28" />
                <Setter Property="HeightRequest" Value="28" />
                <Setter Property="MinimumWidthRequest" Value="28" />
                <Setter Property="MinimumHeightRequest" Value="28" />
                <Setter Property="Padding" Value="0" />
            </Style>

            <!-- Borderless icon button (e.g. remove item) -->
            <Style x:Key="GhostIconButton" TargetType="Button">
                <Setter Property="FontFamily" Value="FASolid" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="BorderWidth" Value="0" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="WidthRequest" Value="32" />
                <Setter Property="HeightRequest" Value="32" />
                <Setter Property="MinimumWidthRequest" Value="32" />
                <Setter Property="MinimumHeightRequest" Value="32" />
                <Setter Property="Padding" Value="0" />
            </Style>

            <!-- ===== Surfaces ===== -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource CardWhite}" />
                <Setter Property="Stroke" Value="{StaticResource Line}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 20,20,20,20" />
                <Setter Property="Padding" Value="14" />
            </Style>

            <Style x:Key="FieldBorder" TargetType="Border">
                <Setter Property="BackgroundColor" Value="#FCF8F4" />
                <Setter Property="Stroke" Value="{StaticResource Line}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 14,14,14,14" />
                <Setter Property="Padding" Value="12,0" />
            </Style>

            <!-- ===== Text helpers ===== -->
            <Style x:Key="SectionTitleStyle" TargetType="Label">
                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                <Setter Property="FontSize" Value="17" />
                <Setter Property="TextColor" Value="{StaticResource TextMain}" />
            </Style>

            <Style x:Key="MutedTextStyle" TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
            </Style>

            <Style x:Key="FieldLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                <Setter Property="TextColor" Value="{StaticResource TextMain}" />
            </Style>

            <Style x:Key="ErrorLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="TextColor" Value="{StaticResource Danger}" />
                <Setter Property="IsVisible" Value="False" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
