<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:FoodOrderingApp.Models"
             xmlns:app="clr-namespace:FoodOrderingApp"
             xmlns:controls="clr-namespace:FoodOrderingApp.Controls"
             x:Class="FoodOrderingApp.Views.CartPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource PageBackground}">

    <ContentPage.Padding>
        <OnPlatform x:TypeArguments="Thickness">
            <On Platform="Android" Value="0,28,0,0" />
        </OnPlatform>
    </ContentPage.Padding>

    <ContentPage.Resources>
        <ResourceDictionary>

            <!-- One row in the cart -->
            <DataTemplate x:Key="CartItemTemplate" x:DataType="models:CartItem">
                <Border Style="{StaticResource CardStyle}" Margin="16,0,16,10" Padding="10">
                    <Grid ColumnDefinitions="70,*,Auto" ColumnSpacing="12">

                        <Border BackgroundColor="{StaticResource OrangeSoft}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 16,16,16,16"
                                WidthRequest="70" HeightRequest="70"
                                VerticalOptions="Center">
                            <Image Source="{Binding Image}" Aspect="AspectFill" />
                        </Border>

                        <!-- Name, unit price, quantity stepper -->
                        <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                            <Label Text="{Binding Name}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="15"
                                   TextColor="{StaticResource TextMain}"
                                   MaxLines="1"
                                   LineBreakMode="TailTruncation" />
                            <Label Text="{Binding UnitPriceText, StringFormat='{0} each'}"
                                   FontSize="11.5"
                                   TextColor="{StaticResource TextSecondary}" />

                            <Border BackgroundColor="{StaticResource OrangeSoft}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 18,18,18,18"
                                    Padding="4"
                                    HorizontalOptions="Start">
                                <HorizontalStackLayout Spacing="2">
                                    <Button Text="{x:Static app:Icons.Minus}"
                                            Style="{StaticResource StepButton}"
                                            Clicked="OnDecreaseClicked" />
                                    <Label Text="{Binding Quantity}"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="14"
                                           TextColor="{StaticResource TextMain}"
                                           WidthRequest="26"
                                           HorizontalTextAlignment="Center"
                                           VerticalOptions="Center" />
                                    <Button Text="{x:Static app:Icons.Plus}"
                                            Style="{StaticResource StepButton}"
                                            Clicked="OnIncreaseClicked" />
                                </HorizontalStackLayout>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Line total and remove -->
                        <VerticalStackLayout Grid.Column="2" Spacing="4"
                                             VerticalOptions="Center"
                                             HorizontalOptions="End">
                            <Label Text="{Binding TotalPriceText}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="15"
                                   TextColor="{StaticResource PrimaryOrange}"
                                   HorizontalOptions="End" />
                            <Button Text="{x:Static app:Icons.Trash}"
                                    Style="{StaticResource GhostIconButton}"
                                    HorizontalOptions="End"
                                    Clicked="OnRemoveClicked" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </DataTemplate>

        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <controls:PageHeader x:Name="Header"
                             Grid.Row="0"
                             Title="My Cart"
                             ShowBack="True"
                             ShowAction="True"
                             ActionIcon="{x:Static app:Icons.Trash}"
                             ActionClicked="OnClearCartClicked" />

        <Grid Grid.Row="1">

            <!-- ===== Cart with items ===== -->
            <CollectionView x:Name="CartCollection"
                            IsVisible="False"
                            SelectionMode="None"
                            ItemTemplate="{StaticResource CartItemTemplate}">
                <CollectionView.Header>
                    <Label x:Name="ItemCountLabel"
                           FontSize="12"
                           TextColor="{StaticResource TextSecondary}"
                           Margin="20,2,16,10" />
                </CollectionView.Header>
                <CollectionView.Footer>
                    <BoxView HeightRequest="8" Color="Transparent" />
                </CollectionView.Footer>
            </CollectionView>

            <!-- ===== Empty cart ===== -->
            <VerticalStackLayout x:Name="EmptyState"
                                 IsVisible="False"
                                 Padding="32"
                                 Spacing="10"
                                 VerticalOptions="Center">
                <Border BackgroundColor="{StaticResource OrangeSoft}"
                        StrokeThickness="0"
                        StrokeShape="Ellipse"
                        WidthRequest="96" HeightRequest="96"
                        HorizontalOptions="Center">
                    <Label Text="{x:Static app:Icons.Cart}"
                           FontFamily="FASolid"
                           FontSize="32"
                           TextColor="{StaticResource PrimaryOrange}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <Label Text="Your cart is empty"
                       FontFamily="OpenSansSemibold"
                       FontSize="20"
                       HorizontalOptions="Center"
                       Margin="0,8,0,0" />
                <Label Text="Browse the menu and add something delicious to get started."
                       FontSize="12.5"
                       TextColor="{StaticResource TextSecondary}"
                       HorizontalTextAlignment="Center" />
                <Button Text="Browse menu"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalOptions="Center"
                        WidthRequest="180"
                        Margin="0,10,0,0"
                        Clicked="OnBrowseMenuClicked" />
            </VerticalStackLayout>
        </Grid>

        <!-- ===== Order summary ===== -->
        <Border x:Name="SummaryPanel"
                Grid.Row="2"
                IsVisible="False"
                BackgroundColor="White"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 24,24,0,0"
                Padding="20,18,20,20">
            <VerticalStackLayout Spacing="8">

                <Label Text="Order summary"
                       FontFamily="OpenSansSemibold"
                       FontSize="16" />

                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                    <Label Text="Subtotal" FontSize="13"
                           TextColor="{StaticResource TextSecondary}" />
                    <Label x:Name="SubtotalLabel" Grid.Column="1" FontSize="13" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Delivery fee" FontSize="13"
                           TextColor="{StaticResource TextSecondary}" />
                    <Label x:Name="DeliveryFeeLabel" Grid.Column="1" FontSize="13" />
                </Grid>

                <BoxView HeightRequest="1" Color="{StaticResource Line}" Margin="0,4" />

                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Total" FontFamily="OpenSansSemibold"
                           FontSize="17" />
                    <Label x:Name="TotalLabel" Grid.Column="1"
                           FontFamily="OpenSansSemibold"
                           FontSize="19"
                           TextColor="{StaticResource PrimaryOrange}" />
                </Grid>

                <Button Text="Proceed to checkout"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,10,0,0"
                        Clicked="OnCheckoutClicked" />
            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>
