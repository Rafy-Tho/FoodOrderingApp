<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:app="clr-namespace:FoodOrderingApp"
             x:Class="FoodOrderingApp.Views.RegisterPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource PageBackground}">

    <ContentPage.Padding>
        <OnPlatform x:TypeArguments="Thickness">
            <On Platform="Android" Value="0,28,0,0" />
        </OnPlatform>
    </ContentPage.Padding>

    <ScrollView>
        <VerticalStackLayout Padding="24,24,24,24" Spacing="16">

            <!-- Logo -->
            <Border BackgroundColor="{StaticResource PrimaryOrange}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 24,24,24,24"
                    WidthRequest="76" HeightRequest="76"
                    HorizontalOptions="Center">
                <Image Source="logo.png"
                       WidthRequest="56" HeightRequest="56"
                       Aspect="AspectFit"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>

            <VerticalStackLayout Spacing="4">
                <Label Text="Create your account"
                       FontFamily="OpenSansSemibold"
                       FontSize="24"
                       HorizontalOptions="Center" />
                <Label Text="It only takes a moment — orders are saved to your own profile."
                       FontSize="12"
                       TextColor="{StaticResource TextSecondary}"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <Border Style="{StaticResource CardStyle}" Padding="18">
                <VerticalStackLayout Spacing="14">

                    <!-- Full name -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Full name" Style="{StaticResource FieldLabelStyle}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Text="{x:Static app:Icons.User}"
                                       FontFamily="FASolid"
                                       FontSize="12"
                                       TextColor="{StaticResource TextSecondary}"
                                       VerticalOptions="Center" />
                                <Entry x:Name="NameEntry"
                                       Grid.Column="1"
                                       Placeholder="e.g. John Smith"
                                       PlaceholderColor="{StaticResource TextSecondary}"
                                       TextColor="{StaticResource TextMain}"
                                       BackgroundColor="Transparent"
                                       MaxLength="60"
                                       ReturnType="Next"
                                       TextChanged="OnFieldTextChanged"
                                       Completed="OnNameCompleted" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Email -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Email" Style="{StaticResource FieldLabelStyle}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Text="{x:Static app:Icons.Envelope}"
                                       FontFamily="FASolid"
                                       FontSize="12"
                                       TextColor="{StaticResource TextSecondary}"
                                       VerticalOptions="Center" />
                                <Entry x:Name="EmailEntry"
                                       Grid.Column="1"
                                       Placeholder="you@example.com"
                                       PlaceholderColor="{StaticResource TextSecondary}"
                                       TextColor="{StaticResource TextMain}"
                                       BackgroundColor="Transparent"
                                       Keyboard="Email"
                                       MaxLength="120"
                                       ReturnType="Next"
                                       TextChanged="OnFieldTextChanged"
                                       Completed="OnEmailCompleted" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Password -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Password" Style="{StaticResource FieldLabelStyle}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Label Text="{x:Static app:Icons.Lock}"
                                       FontFamily="FASolid"
                                       FontSize="12"
                                       TextColor="{StaticResource TextSecondary}"
                                       VerticalOptions="Center" />
                                <Entry x:Name="PasswordEntry"
                                       Grid.Column="1"
                                       IsPassword="True"
                                       Placeholder="At least 6 characters"
                                       PlaceholderColor="{StaticResource TextSecondary}"
                                       TextColor="{StaticResource TextMain}"
                                       BackgroundColor="Transparent"
                                       MaxLength="60"
                                       ReturnType="Next"
                                       TextChanged="OnFieldTextChanged"
                                       Completed="OnPasswordCompleted" />
                                <Button x:Name="TogglePasswordButton"
                                        Grid.Column="2"
                                        Text="{x:Static app:Icons.Eye}"
                                        Style="{StaticResource GhostIconButton}"
                                        Clicked="OnTogglePasswordClicked" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Confirm password -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Confirm password" Style="{StaticResource FieldLabelStyle}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Text="{x:Static app:Icons.Lock}"
                                       FontFamily="FASolid"
                                       FontSize="12"
                                       TextColor="{StaticResource TextSecondary}"
                                       VerticalOptions="Center" />
                                <Entry x:Name="ConfirmEntry"
                                       Grid.Column="1"
                                       IsPassword="True"
                                       Placeholder="Repeat your password"
                                       PlaceholderColor="{StaticResource TextSecondary}"
                                       TextColor="{StaticResource TextMain}"
                                       BackgroundColor="Transparent"
                                       MaxLength="60"
                                       ReturnType="Go"
                                       TextChanged="OnFieldTextChanged"
                                       Completed="OnCreateAccountClicked" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Error message -->
                    <Border x:Name="ErrorBorder"
                            IsVisible="False"
                            BackgroundColor="#FFF1F0"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12,12,12,12"
                            Padding="12,10">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Label Text="{x:Static app:Icons.TriangleExclamation}"
                                   FontFamily="FASolid"
                                   FontSize="12"
                                   TextColor="{StaticResource Danger}"
                                   VerticalOptions="Start"
                                   Margin="0,2,0,0" />
                            <Label x:Name="ErrorLabel"
                                   Grid.Column="1"
                                   FontSize="12"
                                   TextColor="{StaticResource Danger}" />
                        </Grid>
                    </Border>

                    <Button x:Name="CreateAccountButton"
                            Text="Create account"
                            Style="{StaticResource PrimaryButton}"
                            Clicked="OnCreateAccountClicked" />
                </VerticalStackLayout>
            </Border>

            <!-- Sign-in link -->
            <HorizontalStackLayout Spacing="5" HorizontalOptions="Center">
                <Label Text="Already have an account?"
                       FontSize="12.5"
                       TextColor="{StaticResource TextSecondary}"
                       VerticalOptions="Center" />
                <Label Text="Sign in"
                       FontFamily="OpenSansSemibold"
                       FontSize="12.5"
                       TextColor="{StaticResource PrimaryOrange}"
                       VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSignInTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
